{
  "manifest_version": 3,
  "name": "Codex Browser Use",
  "version": "1.0.0",
  "description": "Bridge between Codex AI and Google Chrome - enables AI-powered browser control, page reading, and automation",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "nativeMessaging",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Codex Browser Use"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [{
    "resources": ["content.js"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      }
    }
  }
}
